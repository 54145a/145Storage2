{
	"compilerOptions": {
		"lib": [
			"ESNext"
		],
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"node"
		]
	},
	"include": [
		"storage.js",
		"example.js",
		"vitest.config.ts",
		"test/**/*.ts"
	]
}
